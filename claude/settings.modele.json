{
  "model": "sonnet",
  "advisorModel": "fable",
  "autoCompactWindow": 160000,
  "workflowSizeGuideline": "small",
  "modelSettings": {
    "claude-opus-5-5":   { "effortLevel": "medium" },
    "claude-sonnet-5-5": { "effortLevel": "medium" }
  },
  "env": { "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1", "BASH_MAX_OUTPUT_LENGTH": "15000" },
  "permissions": { "deny": ["CronCreate","CronDelete","CronList","RemoteTrigger","PushNotification",
    "NotebookEdit","EnterWorktree","ExitWorktree",
    "Agent(general-purpose)","Agent(claude)","Agent(Plan)"] },
  "statusLine": { "type": "command", "command": "\"<python>\" \"<home>/.claude/hooks/conso_5h.py\"" },
  "hooks": {
    "UserPromptSubmit": [ { "hooks": [
      { "type": "command", "command": "\"<python>\" \"<home>/.claude/hooks/claude_md_taille.py\"", "timeout": 5 },
      { "type": "command", "command": "\"<python>\" \"<home>/.claude/hooks/suivi_taille.py\"", "timeout": 5 },
      { "type": "command", "command": "\"<python>\" \"<home>/.claude/hooks/pause_longue.py\"", "timeout": 5 },
      { "type": "command", "command": "\"<python>\" \"<home>/.claude/hooks/boucle_compact.py\"", "timeout": 5 } ] } ],
    "PreToolUse": [ { "matcher": "Write|Edit|MultiEdit|Bash|PowerShell", "hooks": [
      { "type": "command", "command": "\"<python>\" \"<home>/.claude/hooks/protege_fichiers.py\"", "timeout": 5 } ] } ]
  }
}
